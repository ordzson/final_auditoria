digraph P1 {
  graph [rankdir=TB, bgcolor="white", label="P1 · mapa causal investigado · corte 2026-10-15T23:59:59-06:00\nReportado ≠ autenticado; enlaces causales pendientes · revisión humana pendiente", labelloc=t, fontsize=17, fontname="DejaVu Sans"];
