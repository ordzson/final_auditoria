  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b"];
  leyenda [shape=note, fillcolor="white", label="AZUL: dato reportado, certeza forense limitada\nÁMBAR: hipótesis causal, certeza baja\nGRIS: desconocido/dependencia\nVERDE: resultado comprobado SOLO en laboratorio\nAristas punteadas: enlace causal no demostrado\nSin porcentajes: no hay base para probabilidades"];
