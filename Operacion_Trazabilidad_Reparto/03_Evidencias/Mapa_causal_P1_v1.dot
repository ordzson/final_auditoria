    elev [fillcolor="#dbeafe", label="02:26 elevación; cuenta desconocida\nPT-21 / EVT-03"];
    sql [fillcolor="#dbeafe", label="02:31 lectura 31,840; login desconocido\nE-03 / PT-21 / EVT-04"];
    red [fillcolor="#dbeafe", label="02:35 ~1.6 GB; contenido desconocido\nE-04 / PT-22 / EVT-05"];
    ord [fillcolor="#dbeafe", label="02:42 cambios en 216 órdenes\nE-05 / PT-23 / EVT-06"];
    dep [fillcolor="#dbeafe", label="03:02 despliegue; aprobación no documentada\nE-06 / Q-10 / EVT-07"];
    alert [fillcolor="#dbeafe", label="03:18 alerta crítica; cierre no documentado\nE-07 / PT-24 / EVT-08"];
    down [fillcolor="#dbeafe", label="03:42 CRM indisponible / cifrado aparente\nNota de extorsión; no prueba de exfiltración\nProyecto pp. 3–4 / EVT-09"];
  }
  ha [fillcolor="#fef3c7", label="H-A · credencial comprometida\ncausa inmediata propuesta; baja certeza"];
  hb [fillcolor="#fef3c7", label="H-B · abuso por persona con acceso legítimo\ncausa inmediata propuesta; baja certeza"];
  hc [fillcolor="#fef3c7", label="H-C · parte legítima y ataque por otra vía\ncausa inmediata alternativa; baja certeza"];
  access [fillcolor="#fef3c7", label="Causa de control propuesta: autenticación/excepciones\nP2; falta configuración/política histórica"];
  tracking [fillcolor="#fef3c7", label="Causa de control propuesta: seguimiento sin responsable verificable\nB1-1 no concluyente; pedir ticket/asignación/acciones"];
  logs [fillcolor="#fef3c7", label="Causa de control propuesta: registros sin protección independiente\nB1-2 no concluyente; pedir ACL/colector/retención"];
  gov [fillcolor="#e5e7eb", label="Causas de gobierno por investigar\nResponsabilidades, terceros y supervisión (P2/P3)\nNo se aportaron políticas, RACI ni decisiones"];
  unknown [fillcolor="#e5e7eb", label="No determinado: persona, contenido, vector y causa raíz\nRelojes sin cota verificable; intervalos ≠ continuidad de logs"];
  lab [fillcolor="#dcfce7", label="Laboratorio, rama separada\nQ-S01: admin ficticio UPDATE/DELETE efectivos\nControl/auditor sin esos permisos; no modificación ejecutada\nNo acredita permisos ni alteración en RedNova"];
  gov -> access [style=dotted, label="hipótesis; pedir decisiones/recertificación"];
  gov -> tracking [style=dotted, label="hipótesis; pedir procedimiento/roles"];
  gov -> logs [style=dotted, label="hipótesis; pedir arquitectura/custodia"];
  access -> ha [style=dotted, label="no probado; sesión/IdP/host"];
  access -> hb [style=dotted, label="no probado; titulares/dispositivos"];
  ha -> vpn [style=dotted, label="no probado; token/host/persona"];
