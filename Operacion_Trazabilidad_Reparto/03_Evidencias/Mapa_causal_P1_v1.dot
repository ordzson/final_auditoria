  vpn -> elev [style=dotted, label="9 min reportados; falta vínculo sesión"];
  elev -> sql [style=dotted, label="5 min; falta login/token/permisos"];
  sql -> red [style=dotted, label="4 min; falta proceso/contenido/destino"];
  elev -> ord [style=dotted, label="no probado; falta transaction/request ID"];
  dep -> down [style=dotted, label="40 min reportados; falta binario/traza/proceso"];
  ord -> down [style=dotted, label="60 min; integridad/causa sin demostrar"];
  tracking -> down [style=dotted, label="no prueba que atención distinta evitara caída"];
  alert -> tracking [style=dotted, label="evidencia incompleta; no demuestra inacción"];
  logs -> unknown [style=dotted, label="no se sabe si hubo borrado; pedir duplicado/contadores"];
  hc -> red [style=dotted, label="legitimidad posible; pedir job/autorización/objetos"];
  hc -> dep [style=dotted, label="aprobación verbal alegada; pedir soporte"];
